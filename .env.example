APP_NAME=Kouma
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de donnees : SQLite en local, PostgreSQL recommande en production (voir docs/ARCHITECTURE.md).
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# File d'attente : "sync" en local (tout s'execute dans la requete, rien d'autre a lancer).
# En production : "database" ou "redis", puis  php artisan queue:work  (voir docs/DEPLOYMENT.md).
QUEUE_CONNECTION=sync

CACHE_STORE=database

# E-mail : alertes de demandes, rappels, reinitialisation de mot de passe, relances d'abonnement.
# Local : « log » ecrit les messages dans storage/logs (rien n'est envoye).
# Production sur un mutualisé : creer une boite (ex. contact@votredomaine), puis
#   MAIL_MAILER=smtp  MAIL_HOST=mail.votredomaine  MAIL_PORT=465 (SSL) ou 587 (TLS)
#   MAIL_USERNAME = l'adresse complete de la boite  MAIL_PASSWORD = son mot de passe (entre guillemets s'il contient # ou un espace)
#   MAIL_FROM_ADDRESS = la meme adresse (l'hebergeur refuse un autre expediteur)
# Verifier ensuite avec : php artisan platform:mail-test vous@exemple.com
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contact@votredomaine.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Compte super admin cree par  php artisan migrate --seed
# Production : renseigner PLATFORM_ADMIN_EMAIL (et de preference PLATFORM_ADMIN_PASSWORD).
# Sans mot de passe, il est genere et affiche une seule fois. En local : admin@kouma.test.
# Cette adresse recoit aussi les demandes des clients (offre, activation WhatsApp).
# ---------------------------------------------------------------------------
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_NAME="Super admin"
PLATFORM_ADMIN_PASSWORD=

# Contacts commerciaux affiches sur le site (boutons « Ecrivez-nous sur WhatsApp » et « Ecrire par e-mail »).
# Valeurs de secours : les Parametres de la plateforme (admin) sont prioritaires. Sans numero, pas de bouton WhatsApp.
BRAND_WHATSAPP=
BRAND_EMAIL=

# ---------------------------------------------------------------------------
# Intelligence artificielle : chaine de bascule Claude Haiku, puis OpenAI, puis Llama.
# Les cles peuvent aussi etre saisies dans le tableau de bord (Admin, IA et fournisseurs) :
# une cle saisie dans le tableau de bord l'emporte sur celle d'ici.
# Sans aucune cle, la plateforme tourne en mode hors ligne (reponses extractives).
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Voix : messages vocaux (ecoute) et reponses en audio. Meme cle OpenAI par defaut.
# PLATFORM_SPEECH=fake                  # voix hors ligne (tests, demonstration)
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# Serveur libre compatible OpenAI pour l'ecoute des langues locales (voir docs/LANGUES.md)
# LOCAL_STT_URL=https://asr.exemple.com/v1
# LOCAL_STT_MODEL=bambara-asr
# LOCAL_STT_KEY=
# Llama via un hebergeur : OpenRouter (le moins cher pour demarrer), DeepInfra ou Together.
OPENROUTER_API_KEY=
DEEPINFRA_API_KEY=
TOGETHER_API_KEY=
# PLATFORM_LLM=fake            # force le mode hors ligne meme si une cle est presente
PLATFORM_EFFORT=low
PLATFORM_MAX_TOKENS=900

# Embeddings (recherche dans les documents) : voyage (recommande, multilingue), openai, ou hashing (local).
# PLATFORM_EMBEDDINGS=voyage
VOYAGE_API_KEY=
# Seuil de pertinence : 0.15 avec "hashing", environ 0.35 avec de vrais embeddings.
# PLATFORM_MIN_SCORE=0.35

# ---------------------------------------------------------------------------
# WhatsApp (voir docs/WHATSAPP.md)
# ---------------------------------------------------------------------------
# Meta : application "Tech Provider" unique pour tous les clients.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v23.0
# Twilio : a renseigner seulement si l'application est derriere un proxy qui masque l'URL publique.
TWILIO_WEBHOOK_BASE_URL=

# ---------------------------------------------------------------------------
# Connexion Facebook officielle (facultatif, exige la validation de l'application par Meta).
# Sans elle, les clients collent le contenu de leur page : voir docs/ARCHITECTURE.md.
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
