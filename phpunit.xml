<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- La suite tourne dans un seul processus : 128 Mo ne suffisent plus avec les tests de photos. -->
        <ini name="memory_limit" value="768M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Les tests ne touchent jamais la base de developpement. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <!-- IA hors ligne : aucun appel reseau reel, resultats deterministes. -->
        <env name="PLATFORM_LLM" value="fake"/>
        <env name="PLATFORM_EMBEDDINGS" value="hashing"/>
        <env name="PLATFORM_SPEECH" value="fake"/>
        <!-- Seuil des embeddings locaux : independant du .env du poste (0.35 sert aux vrais embeddings). -->
        <env name="PLATFORM_MIN_SCORE" value="0.15"/>
        <env name="ANTHROPIC_API_KEY" value=""/>
        <env name="VOYAGE_API_KEY" value=""/>
        <env name="OPENAI_API_KEY" value=""/>
        <env name="META_APP_SECRET" value="test-app-secret"/>
        <env name="META_VERIFY_TOKEN" value="test-verify-token"/>
        <env name="PLATFORM_ADMIN_EMAIL" value=""/>
        <env name="WHATSAPP_AUTO_TEMPLATES" value="false"/>
        <env name="WHATSAPP_TEMPLATE_PAUSE_MS" value="0"/>
    </php>
</phpunit>
